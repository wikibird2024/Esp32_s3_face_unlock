# Applied when sdkconfig does not exist yet. Change settings with
# `idf.py menuconfig`; to make a change the new default, copy it here.
CONFIG_IDF_TARGET="esp32s3"

# ---- Board: CHECK THESE AGAINST YOUR MODULE --------------------------------
# Assumes an ESP32-S3 module with >= 8 MB flash and 8 MB *octal* PSRAM
# (N8R8 / N16R8). For quad PSRAM (N8R2, N4R2) use CONFIG_SPIRAM_MODE_QUAD=y
# AND remove CONFIG_SPIRAM_XIP_FROM_PSRAM below: it copies the app (with
# ~1.5 MB of models) into PSRAM, which does not fit in 2 MB.
# A wrong PSRAM mode fails at boot with "PSRAM ID read error".
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# ---- Partitions -------------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- Speed for ESP-DL (values from Espressif's face recognition example) ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ---- System -----------------------------------------------------------------
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ---- Debug tool support (pc_tool, docs/console_protocol.md) ---------------
# Task list for the console `tasks` command (about 1-2 KB flash).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
# A panic already prints a backtrace and reboots. Core dump over UART
# (decoded with espcoredump.py) stays off: about 10-15 KB flash, 5 KB DRAM
# and 4-12 s of serial output per crash. Turn on when a backtrace is not
# enough:
# CONFIG_ESP_COREDUMP_ENABLE_TO_UART=y
# CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
# CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
